# 大模型服务配置
BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 按账号实际支持的模型填写；历史评测报告使用 deepseek-chat。
LLM_MODEL=deepseek-flash
LLM_MAX_RETRIES=2

# Embedding 与向量检索配置
# 默认使用本地开源模型，便于演示和避免云端扣费风险。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# 如果 EMBEDDING_PROVIDER=openai，则替换为云端 embedding 服务地址和 Key。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
VECTOR_STORE_DIR=./data/chroma
# RAG 检索模式。vector 表示向量检索，keyword 表示关键词检索。
RAG_RETRIEVAL_MODE=keyword

# 前后端服务配置
FRONTEND_BACKEND_BASE_URL=http://127.0.0.1:18000
# Compose 的宿主机端口；修改后同步修改本地 Vite 的 BACKEND_PROXY_TARGET。
BACKEND_PORT=18000
WEB_PORT=8080
STREAMLIT_PORT=8501

# RAG 展示与存储配置
RAG_STORE_TTL_SECONDS=3600
RAG_STORE_MAX_SESSIONS=50
RAG_PREVIEW_TEXT_LIMIT=120
# 向量检索最低相似度阈值，低于该分数时视为知识库没有可靠依据。
RAG_VECTOR_SCORE_THRESHOLD=0.6
# 向量检索没有可靠命中时，是否允许回退到关键词检索。
RAG_KEYWORD_FALLBACK_ENABLED=true

# SQLite 数据库配置
DATABASE_URL=sqlite:///./data/app.db

# n8n 模拟流程：导入工作流并配置 Header Auth 凭据后填写。
# 宿主机 FastAPI 使用 127.0.0.1；容器内 FastAPI 使用 http://n8n:5678。
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_TIMEOUT_SECONDS=10
