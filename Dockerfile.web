# React 构建时只使用公开的 /api 路径，模型凭据留在后端。
FROM node:22-alpine AS build
WORKDIR /app/frontend-react
COPY frontend-react/package.json frontend-react/package-lock.json ./
RUN npm ci
COPY frontend-react/ ./
# 评测页展示构建时的已验收快照。
COPY eval/week4_after_fix_report.json /app/eval/week4_after_fix_report.json
COPY eval/routing_before_report.json \
     eval/routing_after_report.json \
     eval/security_routing_before_report.json \
     eval/security_routing_after_report.json /app/eval/
RUN npm run build

FROM nginx:stable-alpine
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend-react/dist /usr/share/nginx/html
EXPOSE 80
